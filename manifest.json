{
  "manifest_version": 3,
  "name": "Vitrine",
  "version": "1.1.0",
  "description": "One curated piece under glass on every new tab, with an optional second card from your own feeds.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.zippopotam.us/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
